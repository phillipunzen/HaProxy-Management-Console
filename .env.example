# MariaDB: database and user must already exist.
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_NAME=dev_haproxy
DB_USER=haproxy_mgmt
DB_PASSWORD='replace-me'
# Generate keys/password with the command in the Docker installation guide.
ENCRYPTION_KEY=replace-with-fernet-key
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD='replace-with-unique-password-at-least-10-characters'
# Host interface and port; use 127.0.0.1 for a local reverse proxy.
APP_BIND=0.0.0.0
APP_PORT=8100
# Set to your actual browser address, e.g. http://192.168.10.70:8100.
APP_ORIGIN=http://localhost:8100
# For LAN HTTP only; set true when putting the app behind HTTPS.
COOKIE_SECURE=false
# Only the collector stores scalar history. All retention times are bounded.
METRICS_INTERVAL=30
# 30-second buckets for 2 hours; 5-minute buckets for 1 day; hourly for 7 days.
METRICS_RAW_HOURS=2
METRICS_FINE_DAYS=1
METRICS_RETENTION_DAYS=7

# Optional: mount a trusted CA bundle for HTTPS agents with an internal CA.
AGENT_CA_FILE=
# AGENT_CA_FILE=/certs/agent-ca-bundle.pem

# Published image tag used by docker-compose.yml / compose.registry.yaml.
IMAGE_TAG=latest
