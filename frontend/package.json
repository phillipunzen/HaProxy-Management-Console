{
  "name": "haproxy-management-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "tsc --ignoreConfig src/apiError.ts src/proxyHealthState.ts src/proxyOptionTemplates.ts src/accessVisibility.ts src/agentSetupGuidance.ts --target ES2022 --module ESNext --skipLibCheck --outDir .test-build && node --test tests/*.test.mjs",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
